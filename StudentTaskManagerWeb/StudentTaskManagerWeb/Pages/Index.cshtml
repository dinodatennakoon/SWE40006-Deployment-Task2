@page
@model IndexModel

@{
    ViewData["Title"] = "Student Task Manager";
}

<div class="container mt-4">
    <h1 class="mb-4">Student Task Manager</h1>

    <p class="alert alert-info">@Model.AppMessage</p>

    <form method="post" asp-page-handler="Add" class="mb-4">
        <div class="mb-3">
            <label class="form-label">Enter a Task</label>
            <input asp-for="NewTask" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">
            Add Task
        </button>
    </form>

    @if (Model.Tasks.Count > 0)
    {
        <h3>Current Tasks</h3>

        <ul class="list-group mb-3">
            @for (int i = 0; i < Model.Tasks.Count; i++)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @Model.Tasks[i]

                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="index" value="@i" />
                        <button type="submit" class="btn btn-danger btn-sm">
                            Delete
                        </button>
                    </form>
                </li>
            }
        </ul>

        <form method="post" asp-page-handler="Clear">
            <button type="submit" class="btn btn-warning">
                Clear All Tasks
            </button>
        </form>
    }
    else
    {
        <p>No tasks have been added yet.</p>
    }
</div>